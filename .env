# cactusInv deployment defaults. Docker Compose reads this file automatically and
# deploy.sh uses it for Docker Desktop, k3s and k8s. No secrets here: passwords live in
# files under SECRETS_DIR (created by `./deploy.sh --install`).

# Every value is explained in README.md, "Configuration — .env".

# ---- Volume mappings (Docker; host paths, relative paths are relative to this file) ----
DATA_DIR=/data/k3s/local.volumes/cactusinv/data
MARIADB_DATA_DIR=/data/k3s/local.volumes/cactusinv/mariadb
INVOICES_DIR=/data/k3s/local.volumes/cactusinv/invoices
BACKUP_DIR=/data/k3s/local.volumes/cactusinv/backups
SECRETS_DIR=/data/k3s/local.volumes/cactusinv//secrets

# ---- Network ----
HTTP_PORT=8080
MAILPIT_PORT=8025

# ---- Image ----
CACTUSINV_IMAGE=cactusinv:latest

# ---- Application ----
TZ=Africa/Johannesburg
CACTUSINV_LOG_LEVEL=info
# Settings → System Settings → Check for updates reads the newest published version here
# (empty = the VERSION file on GitHub's main branch, what ./deploy.sh --upgrade installs;
# off = never check). It is only read when someone presses the button.
CACTUSINV_UPDATE_URL=
# Set to true when serving over HTTPS (behind a TLS proxy or ingress).
CACTUSINV_COOKIE_SECURE=true
# Created on first start only, when no user exists; the password must be changed at the
# first sign-in. Empty password (the default) = the random one --install generates into the
# admin_password secret and prints (M40).
CACTUSINV_DEFAULT_ADMIN_USER=admin
CACTUSINV_DEFAULT_ADMIN_PASSWORD=

# ---- Database ----
MARIADB_DATABASE=cactusinv
MARIADB_USER=cactusinv

# ---- E-mail ----
# Configure the real mail server in the app: Settings → E-mail server (Gmail preset:
# smtp.gmail.com:587 STARTTLS with a Google app password). Until it is enabled there,
# mail goes to this fallback server — the bundled Mailpit test mailbox by default.
# A fallback password goes in ${SECRETS_DIR}/smtp_password.
CACTUSINV_SMTP_HOST=mailpit
CACTUSINV_SMTP_PORT=1025
CACTUSINV_SMTP_TLS=none
CACTUSINV_SMTP_USER=
CACTUSINV_SMTP_FROM="PrimeSoft Accounts <accounts@primesoft.co.za>"
COMPOSE_PROFILES=mailpit

# ---- Backups ----
# The app takes encrypted backups (ADR-010) daily at these times (24h, comma separated, in
# TZ) into BACKUP_DIR, and prunes them after BACKUP_RETENTION_DAYS (0 = keep all). Stored
# backups need the backup_key secret (generated by --install: copy it off this machine).
BACKUP_TIMES=02:00
BACKUP_RETENTION_DAYS=14
# Largest backup file that can be uploaded for a restore, in MiB.
BACKUP_MAX_UPLOAD_MB=256

# ---- k3s / k8s ----
K8S_NAMESPACE=cactusinv
K8S_NODE_PORT=30080
K8S_MAILPIT_NODE_PORT=30025
# Storage class for the persistent volumes: the name of a StorageClass in the cluster
# (kubectl get storageclass). "" = the cluster default (k3s: local-path). Set it before the
# first install; it cannot change afterwards. README "K8S_STORAGE_CLASS" has the details.
K8S_STORAGE_CLASS=local-storage
# k3s only: keep the three volumes in this folder on the node (mariadb/, invoices/, backups/).
# deploy.sh creates the folders, the no-provisioner class (K8S_STORAGE_CLASS, empty =
# local-storage) and one volume per claim. Empty = the class creates the volumes.
K8S_VOLUME_DIR=/data/k3s/local.volumes/cactusinv
K8S_MARIADB_STORAGE=10Gi
K8S_INVOICES_STORAGE=5Gi
K8S_BACKUP_STORAGE=10Gi
# HTTPS through the cluster's ingress controller (k3s: Traefik on port 443): needed for
# sign-in while CACTUSINV_COOKIE_SECURE=true. README "HTTPS on k3s/k8s" has the details.
K8S_HTTPS=true
# DNS name the site is reached by; empty = any name or the node's address.
K8S_HTTPS_HOST=
# Certificate and key (PEM files on this machine); empty = the controller's self-signed one.
K8S_TLS_CERT=
K8S_TLS_KEY=
# k8s only: registry to push the image to (k3s imports it directly).
K8S_REGISTRY=
