# cactusInv deployment defaults. Docker Compose reads this file automatically and
# deploy.sh uses it for Docker Desktop, k3s and k8s. No secrets here: passwords live in
# files under SECRETS_DIR (created by `./deploy.sh --install`).

# ---- Volume mappings (host paths, relative to this file) ----
DATA_DIR=./data
MARIADB_DATA_DIR=./data/mariadb
INVOICES_DIR=./data/invoices
BACKUP_DIR=./data/backups
SECRETS_DIR=./secrets

# ---- Network ----
HTTP_PORT=8080
MAILPIT_PORT=8025

# ---- Image ----
CACTUSINV_IMAGE=cactusinv:latest

# ---- Application ----
TZ=Africa/Johannesburg
CACTUSINV_LOG_LEVEL=info
# Set to true when serving over HTTPS (behind a TLS proxy or ingress).
CACTUSINV_COOKIE_SECURE=false
# Created on first start only, when no user exists. Change the password after signing in.
CACTUSINV_DEFAULT_ADMIN_USER=admin
CACTUSINV_DEFAULT_ADMIN_PASSWORD=admin

# ---- Database ----
MARIADB_DATABASE=cactusinv
MARIADB_USER=cactusinv

# ---- E-mail (defaults to the bundled Mailpit; set your SMTP server for real delivery)
# Put the SMTP password in ${SECRETS_DIR}/smtp_password.
CACTUSINV_SMTP_HOST=mailpit
CACTUSINV_SMTP_PORT=1025
CACTUSINV_SMTP_TLS=none
CACTUSINV_SMTP_USER=
CACTUSINV_SMTP_FROM="cactusInv <invoices@example.com>"
COMPOSE_PROFILES=mailpit

# ---- Backups ----
# Daily times (24h, comma separated, in TZ) for Docker; a cron expression for k3s/k8s.
BACKUP_TIMES=02:00
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=14

# ---- k3s / k8s ----
K8S_NAMESPACE=cactusinv
K8S_NODE_PORT=30080
K8S_MAILPIT_NODE_PORT=30025
# Storage class for the persistent volumes ("" = cluster default; k3s: local-path).
K8S_STORAGE_CLASS=
K8S_MARIADB_STORAGE=10Gi
K8S_INVOICES_STORAGE=5Gi
K8S_BACKUP_STORAGE=10Gi
# k8s only: registry to push the image to (k3s imports it directly).
K8S_REGISTRY=
